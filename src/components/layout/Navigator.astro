---
import ButtonLink from '@components/control/ButtonLink.astro';
import { routers } from '@constants/router';
import { cn } from '@lib/utils';
import { Icon } from 'astro-icon/components';
import DropdownNav from './DropdownNav';
import ThemeToggle from '@components/theme/ThemeToggle.astro';
import { getLanguageFromAstroUrl, getSiteConfig, getUIText } from '@lib/i18n';
import LanguageSwitcherPopup from '@components/theme/LanguageSwitcherPopup.astro';

// 获取当前语言和配置
const currentLang = getLanguageFromAstroUrl(Astro.url);
const siteConfig = getSiteConfig(currentLang);
const uiText = getUIText(currentLang);

// 获取对应语言的幻念集链接
const thoughtsLink = currentLang === 'en' ? '/en/illusionary-thoughts' : '/illusionary-thoughts';
const thoughtsText = currentLang === 'en' ? 'Thoughts' : '幻念集';
---

<div class="tablet:grow-0 flex grow items-center">
  <!-- 导航菜单 -->
  <div class="tablet:hidden flex grow items-center">
    {
      // 使用 siteConfig.navLinks 进行导航
      siteConfig.navLinks
        ?.filter((item) => item.name !== '幻念集' && item.name !== 'Thoughts')
        .map((item) => {
          const path = item.href;
          const { name } = item;

          return (
            <ButtonLink
              url={path}
              label={name}
              variant="unstyle"
              className={cn(
                'relative text-base tracking-wider after:absolute after:bottom-1 after:left-1/2 after:block after:h-0.5 after:w-0 after:-translate-x-1/2 after:transition-all after:duration-300',
                {
                  'hover:after:w-9/12': true,
                  'after:w-9/12': path === Astro.url.pathname,
                },
              )}
            >
              {name}
            </ButtonLink>
          );
        })
    }
  </div>

  <div class="tablet:gap-2 ml-auto flex items-center gap-4">
    <!-- 添加幻念集链接到右上角，使用动态旋转的风铃图标，进一步增强视觉效果 -->
    <a
      class="flex cursor-pointer items-center text-white transition duration-300 hover:text-blue-300"
      href={thoughtsLink}
      title={thoughtsText}
    >
      <div class="relative">
        <!-- 移除白色背景，直接将图标变成纯白色 -->
        <div class="rainbow-icon h-9 w-9 transition duration-300 hover:scale-125">
          <img
            src="/whirlwind.svg"
            alt={thoughtsText}
            class="slow-spin h-full w-full"
            style="filter: brightness(0) invert(1);"
          />
        </div>
        <!-- 添加多层脉冲动画效果 -->
        <div class="absolute inset-0 animate-ping rounded-full bg-blue-500 opacity-40" style="animation-duration: 2s;"></div>
        <div
          class="absolute inset-0 animate-ping rounded-full bg-cyan-400 opacity-30"
          style="animation-delay: 0.5s; animation-duration: 2.5s;"
        >
        </div>
      </div>
    </a>

    <!-- 语言切换器 -->
    <LanguageSwitcherPopup />

    <ThemeToggle />
  </div>
</div>

<style>
  .slow-spin {
    animation: spin 4s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .enhanced-icon {
    filter: drop-shadow(0 0 8px #3b82f6) brightness(2) contrast(1.5);
    /* 添加发光效果 */
    box-shadow: 0 0 12px rgba(59, 130, 246, 0.8);
  }

  /* 添加悬停时的增强效果 */
  .enhanced-icon:hover {
    filter: drop-shadow(0 0 12px #3b82f6) brightness(2.5) contrast(2);
    box-shadow: 0 0 16px rgba(59, 130, 246, 1);
  }

  /* 七彩虹效果 */
  .rainbow-icon {
    background: linear-gradient(45deg, #ff0000, #ff8000, #ffff00, #80ff00, #00ffff, #0000ff, #8000ff);
    background-size: 400% 400%;
    animation: rainbow 3s ease infinite;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: brightness(1.5);
  }

  @keyframes rainbow {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
</style>

<script is:inline>
  let firstScroll = true;
  let triggerDistance = window.innerHeight * 0.45;
  let lastScrollY = 0;

  const handleScroll = () => {
    const siteHeader = document.getElementById('site-header');
    const mobileMenuContainer = document.getElementById('mobile-menu-container');
    const currentScrollY = window.scrollY;
    const isBeyond = currentScrollY > triggerDistance;

    if (siteHeader) {
      if (isBeyond) {
        siteHeader.classList.add('with-background');
      } else {
        siteHeader.classList.remove('with-background');
      }
    }

    if (firstScroll) {
      firstScroll = false;
      return;
    }

    if (currentScrollY > 0) {
      if (currentScrollY > lastScrollY) {
        // 向下滚动
        if (siteHeader) siteHeader.classList.add('-translate-y-full');
        if (mobileMenuContainer) mobileMenuContainer.classList.add('-translate-y-full');
      } else {
        // 向上滚动
        if (siteHeader) siteHeader.classList.remove('-translate-y-full');
        if (mobileMenuContainer) mobileMenuContainer.classList.remove('-translate-y-full');
      }
    }
    lastScrollY = currentScrollY;
  };

  // 节流函数
  function throttle(func, limit) {
    let lastFunc;
    let lastRan;
    return function () {
      const context = this;
      const args = arguments;
      if (!lastRan) {
        func.apply(context, args);
        lastRan = Date.now();
      } else {
        clearTimeout(lastFunc);
        lastFunc = setTimeout(
          function () {
            if (Date.now() - lastRan >= limit) {
              func.apply(context, args);
              lastRan = Date.now();
            }
          },
          limit - (Date.now() - lastRan),
        );
      }
    };
  }

  window.addEventListener('scroll', throttle(handleScroll, 80), { passive: true });
</script>
