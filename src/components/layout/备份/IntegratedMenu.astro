<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const menuTrigger = document.getElementById('menu-trigger');
    const menuIcon = document.querySelector('.integrated-menu-icon');
    const laserContainer = document.getElementById('laser-container');
    const ghostTarget = document.getElementById('ghost-target');
    const circularMenu = document.getElementById('circular-menu');
    const dragHandle = document.querySelector('.drag-handle');
    const colorBallsContainer = document.getElementById('color-balls-container');
    
    // 获取二级菜单项
    const languageToggle = document.getElementById('language-toggle');
    const themeToggle = document.getElementById('theme-toggle');
    const musicToggle = document.getElementById('music-toggle');

    if (menuIcon) {
      menuIcon.style.opacity = '1';
      menuIcon.style.display = 'block';
      menuIcon.style.visibility = 'visible';
      menuIcon.style.animationPlayState = 'running';
    }

    let timeout;
    
    // 检测是否为移动设备
    const isMobile = window.innerWidth <= 768 || 'ontouchstart' in window;
    
    let isMenuOpen = false;
    let isAnimating = false;
    let isDragging = false;
    let currentX;
    let currentY;
    let initialX;
    let initialY;
    let xOffset = 0;
    let yOffset = 0;
    let menuTop = 0;
    let menuLeft = 0;
    let colorBalls = [];
    let jumpIntervals = [];
    
    // 音乐播放器状态
    let isPlaying = false;
    let currentTrack = null;
    let playlist = [];
    let currentTrackIndex = 0;
    let audioElement = null;
    let audioContext = null;

    
    // 初始化音乐播放器
    async function initMusicPlayer() {
      try {
        // 加载播放列表
        const response = await fetch('/music/playlist.json');
        const data = await response.json();
        playlist = data.playlist || [];
        
        // 初始化Web Audio API
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
        
        // 创建音频元素（用于非demo音频）
        audioElement = new Audio();
        audioElement.volume = 0.7;
        
        // 设置音频事件监听器
        audioElement.addEventListener('ended', () => {
          nextTrack();
        });
        
        audioElement.addEventListener('error', (e) => {
          console.error('音频播放错误:', e);
          showMusicNotification('音频文件加载失败，请检查网络连接');
          isPlaying = false;
          updateMusicToggleIcon();
        });
        
        // 添加时间更新监听器
        audioElement.addEventListener('timeupdate', () => {
          updateSongInfo();
        });
        
        // 添加加载完成监听器
        audioElement.addEventListener('loadedmetadata', () => {
          updateSongInfo();
        });
        
        // 从本地存储加载音乐播放器状态
        const savedState = localStorage.getItem('musicPlayerState');
        if (savedState) {
          const state = JSON.parse(savedState);
          isPlaying = state.isPlaying || false;
          currentTrackIndex = state.currentTrackIndex || 0;
          currentTrack = playlist[currentTrackIndex] || playlist[0];
        } else {
          currentTrack = playlist[0];
        }
        
        // 设置当前音轨
        if (currentTrack) {
          audioElement.src = currentTrack.src;
        }
        
        // 初始化可视化效果和界面更新
        setTimeout(() => {
          initVisualizer();
          updateSongInfo();
          updatePlayButton();
          enhanceHoverEffects();
          
          // 如果有保存的播放状态，恢复播放
          if (isPlaying && audioElement) {
            audioElement.play().then(() => {
              drawVisualizer();
            }).catch(() => {
              isPlaying = false;
              updatePlayButton();
            });
          }
        }, 100);
        
      } catch (error) {
        console.error('初始化音乐播放器失败:', error);
      }
    }


    
    // 播放/暂停音乐
    function toggleMusic() {
      if (!currentTrack) {
        showMusicNotification('音乐播放器未就绪');
        return;
      }
      
      if (isPlaying) {
        // 停止播放
        audioElement.pause();
        isPlaying = false;
        showMusicNotification('⏸️ 音乐已暂停');
        
        // 停止可视化动画
        if (animationId) {
          cancelAnimationFrame(animationId);
          animationId = null;
        }
      } else {
        // 开始播放
        audioElement.play().then(() => {
          isPlaying = true;
          showMusicNotification(`🎵 正在播放: ${currentTrack.title}`);
          
          // 开始可视化效果
          drawVisualizer();
        }).catch(error => {
          console.error('播放失败:', error);
          showMusicNotification('播放失败');
        });
      }
      
      // 更新界面
      updatePlayButton();
      updateSongInfo();
      
      // 更新播放状态类
      const musicMenu = document.getElementById('music-menu');
      if (musicMenu) {
        if (isPlaying) {
          musicMenu.classList.add('playing');
        } else {
          musicMenu.classList.remove('playing');
        }
      }
      
      // 保存状态到本地存储
      savePlayerState();
      
      // 更新音乐按钮图标
      updateMusicToggleIcon();
    }
    
    // 下一首
    function nextTrack() {
      if (playlist.length === 0) return;
      
      // 停止当前播放
      if (isPlaying) {
        if (currentTrack && currentTrack.src === 'demo' && oscillator) {
          oscillator.stop();
          oscillator = null;
        } else if (audioElement) {
          audioElement.pause();
        }
      }
      
      currentTrackIndex = (currentTrackIndex + 1) % playlist.length;
      currentTrack = playlist[currentTrackIndex];
      
      audioElement.src = currentTrack.src;
      
      if (isPlaying) {
        audioElement.play().then(() => {
          showMusicNotification(`🎵 正在播放: ${currentTrack.title}`);
        });
      }
      
      savePlayerState();
    }
    
    // 上一首
    function previousTrack() {
      if (playlist.length === 0) return;
      
      // 停止当前播放
      if (isPlaying && audioElement) {
        audioElement.pause();
      }
      
      currentTrackIndex = (currentTrackIndex - 1 + playlist.length) % playlist.length;
      currentTrack = playlist[currentTrackIndex];
      
      audioElement.src = currentTrack.src;
      
      if (isPlaying) {
        audioElement.play().then(() => {
          showMusicNotification(`🎵 正在播放: ${currentTrack.title}`);
        });
      }
      
      savePlayerState();
    }
    
    // 保存播放器状态
    function savePlayerState() {
      const state = {
        isPlaying: isPlaying,
        currentTrackIndex: currentTrackIndex,
        currentTrack: currentTrack
      };
      localStorage.setItem('musicPlayerState', JSON.stringify(state));
    }
    
    // 更新音乐播放器图标
    function updateMusicToggleIcon() {
      const musicToggle = document.getElementById('music-toggle');
      if (musicToggle) {
        const svg = musicToggle.querySelector('svg');
        const span = musicToggle.querySelector('span');
        
        if (isPlaying) {
          svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" />';
          span.textContent = '暂停';
          svg.classList.remove('text-pink-600');
          svg.classList.add('text-green-600');
        } else {
          svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />';
          span.textContent = '音乐';
          svg.classList.remove('text-green-600');
          svg.classList.add('text-pink-600');
        }
      }
    }
    
    // 初始化音乐播放器
    initMusicPlayer();

    // 拖拽功能
    function makeDraggable(element) {
      let isDragging = false;
      let startX, startY, startLeft, startTop;
      
      element.addEventListener('mousedown', (e) => {
        // 如果点击的是控制按钮，不启动拖拽
        if (e.target.closest('#window-controls')) return;
        // 如果点击的是播放控制按钮，不启动拖拽
        if (e.target.closest('button')) return;
        
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        
        // 获取当前位置
        const rect = element.getBoundingClientRect();
        startLeft = rect.left;
        startTop = rect.top;
        
        element.style.cursor = 'grabbing';
        
        // 防止文本选择
        e.preventDefault();
      });
      
      document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        
        const deltaX = e.clientX - startX;
        const deltaY = e.clientY - startY;
        
        let newLeft = startLeft + deltaX;
        let newTop = startTop + deltaY;
        
        // 边界检查
        const elementWidth = 240; // 播放器固定宽度
        const elementHeight = 240; // 播放器固定高度
        const maxLeft = window.innerWidth - elementWidth;
        const maxTop = window.innerHeight - elementHeight;
        
        newLeft = Math.max(0, Math.min(newLeft, maxLeft));
        newTop = Math.max(0, Math.min(newTop, maxTop));
        
        element.style.left = newLeft + 'px';
        element.style.top = newTop + 'px';
        
        // 检查是否接近边缘（贴附检测）
        const snapDistance = 20;
        if (newLeft < snapDistance) {
          element.classList.add('snap-left');
        } else if (newLeft > maxLeft - snapDistance) {
          element.classList.add('snap-right');
        } else {
          element.classList.remove('snap-left', 'snap-right');
        }
      });
      
      document.addEventListener('mouseup', () => {
        if (!isDragging) return;
        
        isDragging = false;
        element.style.cursor = 'move';
        
        // 获取当前准确位置并保存
        const rect = element.getBoundingClientRect();
        const position = {
          top: rect.top,
          left: rect.left
        };
        localStorage.setItem('musicPlayerPosition', JSON.stringify(position));
        
        // 检查是否需要贴附
        const snapDistance = 50;
        
        if (rect.left < snapDistance) {
          // 贴附到左边
          dockToSide(element, 'left');
        } else if (rect.right > window.innerWidth - snapDistance) {
          // 贴附到右边
          dockToSide(element, 'right');
        }
      });
    }
    
    // 贴附到侧边
    function dockToSide(element, side) {
      element.classList.add(`docked-${side}`);
      
      if (side === 'left') {
        element.style.left = '-120px'; // 圆形一半隐藏在边缘
        element.style.right = 'auto';
      } else {
        element.style.right = '-120px'; // 圆形一半隐藏在边缘
        element.style.left = 'auto';
      }
      
      element.style.top = '50%';
      element.style.transform = 'translateY(-50%)';
      
      localStorage.setItem('musicPlayerDocked', 'true');
      localStorage.setItem('musicPlayerDockSide', side);
    }
    
    // 切换贴附状态
    window.toggleDockPlayer = function() {
      const musicMenu = document.getElementById('music-menu');
      if (!musicMenu) return;
      
      const isDocked = musicMenu.classList.contains('docked-left') || musicMenu.classList.contains('docked-right');
      
      if (isDocked) {
        // 取消贴附
        musicMenu.classList.remove('docked-left', 'docked-right');
        musicMenu.style.right = 'auto';
        musicMenu.style.transform = 'none';
        
        // 恢复到中心位置
        const centerX = window.innerWidth / 2 - 120;
        const centerY = window.innerHeight / 2 - 120;
        musicMenu.style.left = centerX + 'px';
        musicMenu.style.top = centerY + 'px';
        
        localStorage.setItem('musicPlayerDocked', 'false');
        localStorage.removeItem('musicPlayerDockSide');
      } else {
        // 贴附到右边
        dockToSide(musicMenu, 'right');
      }
    }

    // 为播放列表容器添加拖拽功能
    function makeDraggablePlaylist(playlistContainer, musicMenu) {
      let isDragging = false;
      let startX, startY, startLeft, startTop;
      
      playlistContainer.addEventListener('mousedown', (e) => {
        // 如果点击的是关闭按钮或播放列表项，不启动拖拽
        if (e.target.closest('button')) return;
        if (e.target.closest('[onclick*="selectTrack"]')) return;
        
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        
        // 获取音乐播放器的当前位置
        const rect = musicMenu.getBoundingClientRect();
        startLeft = rect.left;
        startTop = rect.top;
        
        musicMenu.style.cursor = 'grabbing';
        
        // 防止文本选择
        e.preventDefault();
      });
      
      document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        
        const deltaX = e.clientX - startX;
        const deltaY = e.clientY - startY;
        
        let newLeft = startLeft + deltaX;
        let newTop = startTop + deltaY;
        
        // 边界检查
        const elementWidth = 240; // 播放器固定宽度
        const elementHeight = 240; // 播放器固定高度
        const maxLeft = window.innerWidth - elementWidth;
        const maxTop = window.innerHeight - elementHeight;
        
        newLeft = Math.max(0, Math.min(newLeft, maxLeft));
        newTop = Math.max(0, Math.min(newTop, maxTop));
        
        musicMenu.style.left = newLeft + 'px';
        musicMenu.style.top = newTop + 'px';
        
        // 检查是否接近边缘（贴附检测）
        const snapDistance = 20;
        if (newLeft < snapDistance) {
          musicMenu.classList.add('snap-left');
        } else if (newLeft > maxLeft - snapDistance) {
          musicMenu.classList.add('snap-right');
        } else {
          musicMenu.classList.remove('snap-left', 'snap-right');
        }
      });
      
      document.addEventListener('mouseup', () => {
        if (!isDragging) return;
        
        isDragging = false;
        musicMenu.style.cursor = 'move';
        
        // 获取当前准确位置并保存
        const rect = musicMenu.getBoundingClientRect();
        const position = {
          top: rect.top,
          left: rect.left
        };
        localStorage.setItem('musicPlayerPosition', JSON.stringify(position));
        
        // 检查是否需要贴附
        const snapDistance = 50;
        
        if (rect.left < snapDistance) {
          // 贴附到左边
          dockToSide(musicMenu, 'left');
        } else if (rect.right > window.innerWidth - snapDistance) {
          // 贴附到右边
          dockToSide(musicMenu, 'right');
        }
      });
    }

