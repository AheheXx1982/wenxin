    // 可视化效果相关变量
    let visualizerCanvas = null;
    let visualizerContext = null;
    let animationId = null;
    let analyser = null;
    let dataArray = null;
    
    // 初始化可视化效果
    function initVisualizer() {
      visualizerCanvas = document.getElementById('visualizer-canvas');
      if (!visualizerCanvas) return;
      
      visualizerContext = visualizerCanvas.getContext('2d');
      
      // 设置canvas尺寸
      const resizeCanvas = () => {
        const rect = visualizerCanvas.getBoundingClientRect();
        visualizerCanvas.width = rect.width;
        visualizerCanvas.height = rect.height;
      };
      
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);
      
      // 如果有音频上下文，设置分析器
      if (audioContext && audioElement) {
        try {
          const source = audioContext.createMediaElementSource(audioElement);
          analyser = audioContext.createAnalyser();
          analyser.fftSize = 64;
          
          source.connect(analyser);
          analyser.connect(audioContext.destination);
          
          const bufferLength = analyser.frequencyBinCount;
          dataArray = new Uint8Array(bufferLength);
        } catch (error) {
          console.log('音频分析器初始化失败:', error);
        }
      }
    }
    
    // 绘制可视化效果
    function drawVisualizer() {
      if (!visualizerContext || !visualizerCanvas) return;
      
      const width = visualizerCanvas.width;
      const height = visualizerCanvas.height;
      const centerX = width / 2;
      const centerY = height / 2;
      
      // 清除画布
      visualizerContext.clearRect(0, 0, width, height);
      
      if (isPlaying && analyser && dataArray) {
        // 获取音频数据
        analyser.getByteFrequencyData(dataArray);
        
        // 绘制圆形频谱
        const radius = Math.min(width, height) * 0.3;
        const barCount = dataArray.length;
        
        for (let i = 0; i < barCount; i++) {
          const angle = (i / barCount) * Math.PI * 2;
          const barHeight = (dataArray[i] / 255) * radius * 0.5;
          
          const x1 = centerX + Math.cos(angle) * radius;
          const y1 = centerY + Math.sin(angle) * radius;
          const x2 = centerX + Math.cos(angle) * (radius + barHeight);
          const y2 = centerY + Math.sin(angle) * (radius + barHeight);
          
          // 渐变颜色
          const hue = (i / barCount) * 360;
          visualizerContext.strokeStyle = `hsl(${hue}, 70%, 60%)`;
          visualizerContext.lineWidth = 2;
          
          visualizerContext.beginPath();
          visualizerContext.moveTo(x1, y1);
          visualizerContext.lineTo(x2, y2);
          visualizerContext.stroke();
        }
      } else {
        // 静态装饰效果
        const time = Date.now() * 0.001;
        const radius = Math.min(width, height) * 0.25;
        
        for (let i = 0; i < 12; i++) {
          const angle = (i / 12) * Math.PI * 2 + time * 0.5;
          const x = centerX + Math.cos(angle) * radius;
          const y = centerY + Math.sin(angle) * radius;
          
          visualizerContext.fillStyle = `hsla(${(i * 30 + time * 50) % 360}, 50%, 50%, 0.3)`;
          visualizerContext.beginPath();
          visualizerContext.arc(x, y, 3, 0, Math.PI * 2);
          visualizerContext.fill();
        }
      }
      
      if (isPlaying) {
        animationId = requestAnimationFrame(drawVisualizer);
      }
    }
    
    // 更新歌曲信息显示
    function updateSongInfo() {
      const titleElement = document.getElementById('song-title');
      const artistElement = document.getElementById('song-artist');
      const progressElement = document.getElementById('song-progress');
      const playIndicator = document.getElementById('play-indicator');
      
      if (currentTrack) {
        if (titleElement) titleElement.textContent = currentTrack.title || '未知歌曲';
        if (artistElement) artistElement.textContent = currentTrack.artist || '未知艺术家';
      } else {
        if (titleElement) titleElement.textContent = '未播放';
        if (artistElement) artistElement.textContent = '选择音乐';
      }
      
      // 更新播放指示器
      if (playIndicator) {
        const indicator = playIndicator.querySelector('div');
        if (indicator) {
          if (isPlaying) {
            indicator.style.opacity = '1';
          } else {
            indicator.style.opacity = '0';
          }
        }
      }
      
      // 更新进度
      if (progressElement && audioElement && currentTrack) {
        const currentTime = audioElement.currentTime || 0;
        const duration = audioElement.duration || 0;
        
        const formatTime = (time) => {
          const minutes = Math.floor(time / 60);
          const seconds = Math.floor(time % 60);
          return `${minutes}:${seconds.toString().padStart(2, '0')}`;
        };
        
        if (duration > 0) {
          progressElement.textContent = `${formatTime(currentTime)} / ${formatTime(duration)}`;
        } else {
          progressElement.textContent = '--:-- / --:--';
        }
      }
    }
    
