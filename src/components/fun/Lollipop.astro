---
interface Props {
  /**
   * 棒棒糖的颜色
   * @default "pink"
   */
  color?: string;
  /**
   * 棒棒糖的大小
   * @default "md"
   */
  size?: 'sm' | 'md' | 'lg';
  /**
   * 是否有动画效果
   * @default true
   */
  animated?: boolean;
}

const { color = 'pink', size = 'md', animated = true } = Astro.props;

// 定义不同尺寸的样式
const sizeClasses = {
  sm: 'w-8 h-8',
  md: 'w-12 h-12',
  lg: 'w-16 h-16',
};

// 定义不同颜色的样式
const colorClasses = {
  pink: 'bg-pink-400',
  blue: 'bg-blue-400',
  green: 'bg-green-400',
  yellow: 'bg-yellow-400',
  purple: 'bg-purple-400',
  red: 'bg-red-400',
};
---

<div class={`inline-block relative ${sizeClasses[size]}`}>
  <!-- 棒棒糖的棍子 -->
  <div class="absolute bottom-0 left-1/2 h-8 w-1 -translate-x-1/2 transform rounded-full bg-amber-700"></div>

  <!-- 棒棒糖的圆形糖果 -->
  <div
    class={`
      ${colorClasses[color as keyof typeof colorClasses] || colorClasses.pink} 
      ${sizeClasses[size]} 
      rounded-full 
      relative 
      shadow-lg
      ${animated ? 'animate-[lollipop-wiggle_2s_ease-in-out_infinite]' : ''}
    `}
  >
    <!-- 糖果上的高光效果 -->
    <div class="absolute top-1 left-1 h-1/3 w-1/3 rounded-full bg-white/30"></div>

    <!-- 糖果上的条纹效果 -->
    <div class="absolute top-1/4 left-0 h-1 w-full rotate-12 transform rounded-full bg-white/20"></div>
    <div class="absolute top-1/2 left-0 h-1 w-full -rotate-12 transform rounded-full bg-white/20"></div>
    <div class="absolute bottom-1/4 left-0 h-1 w-full rotate-6 transform rounded-full bg-white/20"></div>
  </div>
</div>
