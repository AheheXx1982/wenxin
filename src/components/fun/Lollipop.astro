---
interface Props {
  /**
   * 棒棒糖的颜色
   * @default "pink"
   */
  color?: string;
  /**
   * 棒棒糖的大小
   * @default "md"
   */
  size?: 'sm' | 'md' | 'lg';
  /**
   * 是否有动画效果
   * @default true
   */
  animated?: boolean;
}

const { color = 'pink', size = 'md', animated = true } = Astro.props;

// 定义不同尺寸的样式
const sizeClasses = {
  sm: 'w-12 h-12',
  md: 'w-20 h-20',
  lg: 'w-28 h-28',
};

// 棒子的尺寸
const stickClasses = {
  sm: 'w-1 h-12',
  md: 'w-1.5 h-20',
  lg: 'w-2 h-28',
};

// 定义不同颜色的样式（更贴近电影原版的颜色）
const colorClasses = {
  pink: 'bg-[#ff69b4]', // 更鲜艳的粉红色
  blue: 'bg-[#1e90ff]', // 鲜艳的蓝色
  green: 'bg-[#32cd32]', // 青草绿
  yellow: 'bg-[#ffd700]', // 金黄色
  purple: 'bg-[#9370db]', // 紫罗兰色
  red: 'bg-[#ff4500]', // 橙红色
};
---

<div class={`inline-block relative ${size === 'sm' ? 'w-12' : size === 'md' ? 'w-20' : 'w-28'}`}>
  <!-- 棒棒糖的棍子（更贴近电影中的木质纹理） -->
  <div
    class={`
      absolute bottom-0 left-1/2 transform -translate-x-1/2 
      ${stickClasses[size as keyof typeof stickClasses]} 
      bg-amber-800 rounded-full
      ${animated ? 'animate-[lollipop-wiggle_2s_ease-in-out_infinite]' : ''}
    `}
  >
    <!-- 棍子上的纹理 -->
    <div class="absolute top-0 left-1/4 h-full w-0.5 bg-amber-900/30"></div>
    <div class="absolute top-0 right-1/4 h-full w-0.5 bg-amber-900/30"></div>
  </div>

  <!-- 棒棒糖的圆形糖果（更贴近电影原版的质感） -->
  <div
    class={`
      ${colorClasses[color as keyof typeof colorClasses] || colorClasses.pink} 
      ${sizeClasses[size]} 
      rounded-full 
      relative 
      shadow-lg
      border-2 border-white/30
      ${animated ? 'animate-[lollipop-bounce_3s_ease-in-out_infinite]' : ''}
    `}
    style={{
      boxShadow: 'inset -5px -5px 10px rgba(0, 0, 0, 0.2), inset 5px 5px 10px rgba(255, 255, 255, 0.2)',
    }}
  >
    <!-- 糖果上的高光效果（更明显） -->
    <div class="absolute top-2 left-2 h-1/4 w-1/4 rounded-full bg-white/50 blur-sm"></div>

    <!-- 糖果上的"M"字母（电影中棒棒糖上的标志性字母） -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 transform">
      <span class="text-xs font-bold text-white md:text-sm lg:text-base" style="text-shadow: 1px 1px 1px rgba(0,0,0,0.5);">
        M
      </span>
    </div>

    <!-- 糖果边缘的光泽 -->
    <div class="absolute inset-0 rounded-full border-2 border-white/20"></div>
  </div>
</div>

<style>
  @keyframes lollipop-wiggle {
    0%,
    100% {
      transform: translateX(-50%) rotate(-5deg);
    }
    50% {
      transform: translateX(-50%) rotate(5deg);
    }
  }

  @keyframes lollipop-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
</style>
