// 名言列表（中文）—— 内容待更新
const guoChunlinQuotesZh: string[] = [];

// 名言列表（英文）—— 内容待更新
const guoChunlinQuotesEn: string[] = [];

// 根据语言选择相应的名言列表
const quotes = lang === 'en' ? [...wangXiaoboQuotesEn, ...guoChunlinQuotesEn] : [...wangXiaoboQuotesZh, ...guoChunlinQuotesZh];

// 随机选择一条名言（列表为空时显示占位提示）
const randomQuote = quotes.length > 0 ? quotes[Math.floor(Math.random() * quotes.length)] : '名言内容待更新……';
---

<div class="w-full overflow-hidden py-3">
  <div class="relative flex whitespace-nowrap">
    <style is:global>
      @keyframes marquee {
        0% {
          transform: translateX(100%);
        }
        100% {
          transform: translateX(-100%);
        }
      }

      .marquee-content {
        display: inline-block;
        padding-left: 100%;
        animation: marquee linear 1 forwards;
      }

      .marquee-content:hover {
        animation-play-state: paused;
      }
    </style>

    <div class="marquee-content" style={`animation-duration: ${speed}s;`}>
      <span class="mx-4 text-sm text-gray-600 italic" data-quote>"{randomQuote}"</span>
    </div>
  </div>
</div>

<script define:vars={{ quotes }}>
  // 每次页面加载时重新随机选择一条名言（而非使用构建时的固定值）
  (function () {
    const span = document.querySelector('[data-quote]');
    if (!span) return;
    if (quotes && quotes.length > 0) {
      const idx = Math.floor(Math.random() * quotes.length);
      span.textContent = `"${quotes[idx]}"`;
    }
  })();
</script>
