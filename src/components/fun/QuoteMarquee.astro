---
interface Props {
  speed?: number; // 滚动速度，单位：秒
  lang?: string; // 语言参数
}

const { speed = 25, lang = 'zh' } = Astro.props;

// 王小波格言（中文）
const wangXiaoboQuotesZh = [
  '一个人只拥有此生此世是不够的，他还应该拥有诗意的世界。——王小波',
  '我活在世上，无非想要明白些道理，遇见些有趣的事。——王小波',
  '人的一切痛苦，本质上都是对自己无能的愤怒。——王小波',
  '人生唯一有把握不会落空的等待是那必然到来的死亡。——王小波',
  '智慧本身就是好的。有一天我们都会死去，追求智慧的道路还会有人走着。——王小波',
  '一个人想象自己不懂得的事很容易浪漫。——王小波',
  '生活是天籁，需要静神倾听。——王小波',
  '人应该有所信仰，有所敬畏。——王小波',
  '正确的看法是，这是对一个人的打击，给他带来了痛苦，但是也使他成长。——王小波',
  '一个人快乐或悲伤，只要不是装出来的，就必有其道理。——王小波',
];

// 王小波格言（英文）
const wangXiaoboQuotesEn = [
  'A person who only has this life is not enough; he should also have a poetic world. —— Wang Xiaobo',
  'I live in this world, just wanting to understand some truths and encounter some interesting things. —— Wang Xiaobo',
  "All human suffering is essentially anger at one's own incompetence. —— Wang Xiaobo",
  'The only wait in life that is certain not to be in vain is the inevitable death. —— Wang Xiaobo',
  'Wisdom itself is good. One day we will all die, but the path of pursuing wisdom will still be walked by others. —— Wang Xiaobo',
  "It's easy for a person to be romantic about things they don't understand. —— Wang Xiaobo",
  'Life is music from heaven, requiring quiet listening. —— Wang Xiaobo',
  'People should have faith and reverence. —— Wang Xiaobo',
  'The correct view is that this is a blow to a person, bringing him pain, but also making him grow. —— Wang Xiaobo',
  "A person's happiness or sadness, as long as it's not fake, must have its reason. —— Wang Xiaobo",
];

// 郭春林格言（中文）—— 基于其《哲学智慧与人生思考》《唤醒心力，重构心智》讲座中的代表性观点
const guoChunlinQuotesZh = [
  '认知决定你的格局，也决定你和财富之间的差距。——郭春林',
  '人这一生，无非是想活得自由、通透、富足。——郭春林',
  '透过现象看本质，是认知世界的第一课。——郭春林',
  '哲学不是空谈，是澄清概念、设定判断、构建系统。——郭春林',
  '感性思维靠本能，因果思维靠逻辑，辩证思维靠立体，系统思维靠整体。——郭春林',
  '人一生至少有一半的时间在应对各种无力感，战胜无力，才能向上生长。——郭春林',
  '看清世界本来的样子，才能做出不后悔的选择。——郭春林',
  '思考的深度，决定一个人能走多远。——郭春林',
];

// 郭春林格言（英文）
const guoChunlinQuotesEn = [
  'Cognition determines your horizon, and the gap between you and wealth. —— Guo Chunlin',
  'What we seek in life is simply to live freely, clearly, and abundantly. —— Guo Chunlin',
  'Seeing through appearances to the essence is the first lesson of understanding the world. —— Guo Chunlin',
  'Philosophy is not empty talk — it is clarifying concepts, forming judgments, and building systems. —— Guo Chunlin',
  'Perceptual thinking relies on instinct, causal thinking on logic, dialectical thinking on perspective, and systemic thinking on the whole. —— Guo Chunlin',
  'We spend half our lives coping with powerlessness; overcoming it is how we grow upward. —— Guo Chunlin',
  'Only by seeing the world as it truly is can you make choices without regret. —— Guo Chunlin',
  'The depth of your thinking decides how far you can go. —— Guo Chunlin',
];

// 根据语言选择相应的名言列表（问心站：王小波 + 郭春林）
const quotes = lang === 'en' ? [...wangXiaoboQuotesEn, ...guoChunlinQuotesEn] : [...wangXiaoboQuotesZh, ...guoChunlinQuotesZh];

// 随机选择一条名言
const randomQuote = quotes[Math.floor(Math.random() * quotes.length)];
---

<div class="w-full overflow-hidden py-3">
  <div class="relative flex whitespace-nowrap">
    <style is:global>
      @keyframes marquee {
        0% {
          transform: translateX(100%);
        }
        100% {
          transform: translateX(-100%);
        }
      }

      .marquee-content {
        display: inline-block;
        padding-left: 100%;
        animation: marquee linear infinite;
      }

      .marquee-content:hover {
        animation-play-state: paused;
      }
    </style>

    <div class="marquee-content" style={`animation-duration: ${speed}s;`}>
      <span class="mx-4 text-sm text-gray-600 italic">"{randomQuote}"</span>
    </div>
  </div>
</div>
