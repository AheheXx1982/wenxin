    25% { transform: translateX(25px) translateY(-15px) rotate(90deg); filter: hue-rotate(120deg) brightness(1.5); }
    50% { transform: translateX(0) translateY(-30px) rotate(180deg); filter: hue-rotate(240deg) brightness(2); }
    75% { transform: translateX(-25px) translateY(-15px) rotate(270deg); filter: hue-rotate(300deg) brightness(1.5); }
  }

