  }

  @keyframes dimensionFusion {
    0%, 100% { transform: scale(1) rotate(0deg); filter: brightness(1) blur(0) saturate(1); }
    25% { transform: scale(0.3) rotate(120deg); filter: brightness(3) blur(4px) saturate(2); }
    50% { transform: scale(0.1) rotate(240deg); filter: brightness(5) blur(8px) saturate(3); }
    75% { transform: scale(0.5) rotate(360deg); filter: brightness(2.5) blur(2px) saturate(1.5); }
  }

  @keyframes atomicFission {
    0%, 100% { transform: scale(1) translateX(0); filter: brightness(1) contrast(1) saturate(1); }
    20% { transform: scale(2.2) translateX(-15px); filter: brightness(0.2) contrast(4) saturate(3); }
    40% { transform: scale(2.8) translateX(20px); filter: brightness(0.1) contrast(5) saturate(4); }
    60% { transform: scale(2.4) translateX(-12px); filter: brightness(0.3) contrast(3.5) saturate(2.5); }
    80% { transform: scale(1.6) translateX(8px); filter: brightness(0.6) contrast(2) saturate(1.5); }
  }

  @keyframes phantomBlink {
    0%, 100% { opacity: 1; transform: scale(1); filter: brightness(1); }
    25% { opacity: 0.05; transform: scale(0.5); filter: brightness(3); }
    50% { opacity: 0.01; transform: scale(0.3); filter: brightness(5); }
    75% { opacity: 0.2; transform: scale(0.7); filter: brightness(2); }
  }

  @keyframes galaxyVortex {
    0% { transform: rotate(0deg) scale(1); filter: hue-rotate(0deg) brightness(1) blur(0); }
    25% { transform: rotate(90deg) scale(1.2); filter: hue-rotate(120deg) brightness(1.5) blur(1px); }
    50% { transform: rotate(180deg) scale(0.8); filter: hue-rotate(240deg) brightness(2) blur(2px); }
    75% { transform: rotate(270deg) scale(1.3); filter: hue-rotate(300deg) brightness(1.7) blur(1px); }
    100% { transform: rotate(360deg) scale(1); filter: hue-rotate(360deg) brightness(1) blur(0); }
  }

  @keyframes energyPopcorn {
    0%, 70% { transform: scale(1) translateY(0) rotate(0deg); filter: brightness(1); }
    75% { transform: scale(1.8) translateY(-35px) rotate(20deg); filter: brightness(2); }
    80% { transform: scale(2.2) translateY(-50px) rotate(-15deg); filter: brightness(3); }
    85% { transform: scale(0.6) translateY(15px) rotate(30deg); filter: brightness(1.5); }
    90% { transform: scale(1.4) translateY(-20px) rotate(-10deg); filter: brightness(2); }
    100% { transform: scale(1) translateY(0) rotate(0deg); filter: brightness(1); }
  }

  @keyframes liquidSnake {
    0% { transform: translateX(0) scaleX(1) translateY(0); border-radius: 50%; }
    20% { transform: translateX(35px) scaleX(1.8) translateY(-15px); border-radius: 20% 80% 20% 80%; }
    40% { transform: translateX(15px) scaleX(0.4) translateY(25px); border-radius: 80% 20% 80% 20%; }
    60% { transform: translateX(-30px) scaleX(2) translateY(-12px); border-radius: 30% 70% 30% 70%; }
    80% { transform: translateX(-40px) scaleX(0.5) translateY(18px); border-radius: 70% 30% 70% 30%; }
    100% { transform: translateX(0) scaleX(1) translateY(0); border-radius: 50%; }
  }

  @keyframes plasmaTornado {
    0% { transform: rotate(0deg) scale(1) translateY(0); border-radius: 50%; filter: brightness(1); }
    20% { transform: rotate(90deg) scale(1.6) translateY(-20px); border-radius: 15%; filter: brightness(2); }
    40% { transform: rotate(180deg) scale(0.4) translateY(30px); border-radius: 85%; filter: brightness(3); }
