    45% { transform: translateY(-40px) scaleY(0.7) scaleX(1.3); opacity: 0.9; }
    60% { transform: translateY(20px) scaleY(1.5) scaleX(0.8); opacity: 1; }
    80% { transform: translateY(-15px) scaleY(1.1) scaleX(1.1); opacity: 1; }
  }

