    0%, 100% { transform: translateY(0) rotate(0deg) translateX(0); filter: blur(0px) brightness(1); }
    20% { transform: translateY(-30px) rotate(15deg) translateX(20px); filter: blur(1px) brightness(1.3); }
    40% { transform: translateY(-45px) rotate(-10deg) translateX(-15px); filter: blur(2px) brightness(1.6); }
