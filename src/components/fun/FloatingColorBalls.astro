  { name: '蓝色', value: 'blue', color: '#3b82f6' },
  { name: '绿色', value: 'green', color: '#22c55e' },
  { name: '紫色', value: 'purple', color: '#8b5cf6' },
  { name: '橙色', value: 'orange', color: '#f97316' },
  { name: '青色', value: 'cyan', color: '#06b6d4' },
  { name: '红色', value: 'red', color: '#ef4444' },
  { name: '靛蓝', value: 'indigo', color: '#6366f1' },
  
  // 扩展色系 (15个)
  { name: '黄色', value: 'yellow', color: '#eab308' },
  { name: '深紫色', value: 'violet', color: '#7c3aed' },
  { name: '薄荷绿', value: 'emerald', color: '#10b981' },
  { name: '珊瑚色', value: 'coral', color: '#ff7875' },
  { name: '天蓝色', value: 'sky', color: '#0ea5e9' },
  { name: '薰衣草', value: 'lavender', color: '#a78bfa' },
  { name: '桃色', value: 'peach', color: '#fb7185' },
  { name: '翡翠绿', value: 'jade', color: '#20B2AA' },
  { name: '金色', value: 'gold', color: '#d97706' },
  { name: '玫瑰金', value: 'rose-gold', color: '#e11d48' },
  { name: '深青色', value: 'teal', color: '#40E0D0' },
  { name: '酒红色', value: 'wine', color: '#DC143C' },
  { name: '橄榄绿', value: 'olive', color: '#9ACD32' },
  { name: '石板蓝', value: 'slate', color: '#87CEEB' },
  { name: '琥珀色', value: 'amber', color: '#f59e0b' }
];

// 已移除渐变系统，使用纯色显示

// 颜色相近检测函数 - 使用HSL色彩空间计算相似度
function hexToHsl(hex) {
  const r = parseInt(hex.slice(1, 3), 16) / 255;
  const g = parseInt(hex.slice(3, 5), 16) / 255;
  const b = parseInt(hex.slice(5, 7), 16) / 255;

  const max = Math.max(r, g, b);
  const min = Math.min(r, g, b);
  let h, s, l = (max + min) / 2;

  if (max === min) {
    h = s = 0;
  } else {
    const d = max - min;
    s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    switch (max) {
      case r: h = (g - b) / d + (g < b ? 6 : 0); break;
      case g: h = (b - r) / d + 2; break;
      case b: h = (r - g) / d + 4; break;
    }
    h /= 6;
  }

  return [h * 360, s * 100, l * 100];
}

function areColorsSimilar(color1, color2, threshold = 30) {
  const [h1, s1, l1] = hexToHsl(color1);
  const [h2, s2, l2] = hexToHsl(color2);
  
  // 色相差异（考虑环形特性）
  let hueDiff = Math.abs(h1 - h2);
  if (hueDiff > 180) hueDiff = 360 - hueDiff;
  
  // 饱和度和亮度差异
  const satDiff = Math.abs(s1 - s2);
  const lightDiff = Math.abs(l1 - l2);
  
  // 综合相似度评分
  const similarity = hueDiff + satDiff * 0.5 + lightDiff * 0.3;
  return similarity < threshold;
}

// 智能选择12个颜色球，避免相近颜色同时出现
function selectDiverseColors(colors, count = 12) {
  const selected = [];
  const shuffled = [...colors].sort(() => Math.random() - 0.5);
  
  for (const color of shuffled) {
    if (selected.length >= count) break;
    
    // 检查与已选颜色的相似度
    const similarCount = selected.filter(selectedColor => 
      areColorsSimilar(color.color, selectedColor.color)
    ).length;
    
    // 相近颜色最多允许2个
    if (similarCount < 2) {
      selected.push(color);
    }
  }
  
  // 如果选择的颜色不够12个，补充剩余的
  if (selected.length < count) {
    const remaining = shuffled.filter(color => !selected.includes(color));
    selected.push(...remaining.slice(0, count - selected.length));
  }
  
  return selected;
}

// 选择12个多样化的颜色球显示
const visibleColors = selectDiverseColors(themeColors, 12);

// 生成无序位置布局 - 增强版，增大活动范围并控制字体区域
function generateRandomPositions(count) {
  const positions = [];
  const containerWidth = 100; // 百分比
  const containerHeight = 100; // 百分比
  
  // 默认使用桌面端配置，客户端会重新计算
  const ballSize = 6;
  const minDistance = 1.2;
  const fontArea = { left: 15, right: 85, top: 25, bottom: 75 };
  
  let fontAreaCount = 0; // 字体区域球计数器
  
  for (let i = 0; i < count; i++) {
    let position;
    let attempts = 0;
    
    do {
      // 增大活动范围，允许负值和超出100%的值
      position = {
        left: (Math.random() - 0.1) * (containerWidth + 20) - 10, // 可以从-10%到110%
        top: (Math.random() - 0.05) * (containerHeight + 30) - 15  // 可以从-15%到115%
      };
      attempts++;
    } while (
      attempts < 100 && // 增加尝试次数
      (isInFontArea(position, fontArea, ballSize) && fontAreaCount >= 3) ||
      isTooClose(position, positions, ballSize * minDistance) // 使用响应式最小间距
    );
    
    // 如果球在字体区域，增加计数
    if (isInFontArea(position, fontArea, ballSize)) {
      fontAreaCount++;
    }
    
    positions.push(position);
  }
  
  return positions;
}

function isInFontArea(pos, fontArea, ballSize) {
  return pos.left + ballSize > fontArea.left && 
         pos.left < fontArea.right && 
         pos.top + ballSize > fontArea.top && 
         pos.top < fontArea.bottom;
}

function isTooClose(pos, existingPositions, minDistance) {
  return existingPositions.some(existing => {
    const distance = Math.sqrt(
      Math.pow(pos.left - existing.left, 2) + 
      Math.pow(pos.top - existing.top, 2)
    );
    return distance < minDistance;
  });
}

const ballPositions = generateRandomPositions(12);
---

<div class="color-balls-container">
  {visibleColors.map((colorData, index) => {
    // 使用纯色背景，避免渐变产生黑色
    const position = ballPositions[index];
    
    return (
      <div 
        class="color-ball"
        data-color={colorData.color}
        data-value={colorData.value}
        data-index={index}
        title={colorData.name}
        style={`
          background: ${colorData.color}; 
          animation-delay: ${index * 0.1}s;
          left: ${position.left}%;
          top: ${position.top}%;
        `}
      >
        <div class="ball-shine"></div>
        <div class="ball-particles"></div>
      </div>
    );
  })}
</div>

<style>
  .color-balls-container {
    width: 100%;
    height: 420px; /* 增加高度从320px到420px */
    position: relative;
    background: rgba(255, 255, 255, 0.08); /* 纯色半透明背景 */
    border-radius: 20px;
    overflow: visible; /* 允许球超出容器边界 */
    border: 2px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    margin-bottom: 20px; /* 增加底部边距，为动画留出空间 */
    padding: 10px;
  }

  .dark .color-balls-container {
    background: rgba(0, 0, 0, 0.15); /* 纯色半透明背景 */
    border-color: rgba(255, 255, 255, 0.1);
  }

  .color-ball {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    position: absolute; /* 改为绝对定位 */
    border: 3px solid rgba(255, 255, 255, 0.4);
    box-shadow: 
      0 6px 16px rgba(0, 0, 0, 0.25),
      inset 0 2px 0 rgba(255, 255, 255, 0.4);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    animation: floatBase 3s ease-in-out infinite;
    z-index: 1;
  }

  .ball-shine {
    position: absolute;
    top: 20%;
    left: 25%;
    width: 35%;
    height: 35%;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    filter: blur(2px);
    pointer-events: none;
  }

  .ball-particles {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  /* 高级特效系统 - 18种随机特效 */
  .color-ball.effect-1 { animation: magneticBounce 3s ease-in-out infinite; }
  .color-ball.effect-2 { animation: cosmicSpin 2.5s linear infinite; }
  .color-ball.effect-3 { animation: quantumJump 2.8s ease-in-out infinite; }
  .color-ball.effect-4 { animation: etherealFloat 4s ease-in-out infinite; }
  .color-ball.effect-5 { animation: stellarExplode 3s ease-in-out infinite; }
  .color-ball.effect-6 { animation: dimensionFusion 2.8s ease-in-out infinite; }
  .color-ball.effect-7 { animation: atomicFission 3.2s ease-in-out infinite; }
  .color-ball.effect-8 { animation: phantomBlink 1.5s ease-in-out infinite; }
  .color-ball.effect-9 { animation: galaxyVortex 4s linear infinite; }
  .color-ball.effect-10 { animation: energyPopcorn 2.2s ease-in-out infinite; }
  .color-ball.effect-11 { animation: liquidSnake 5s ease-in-out infinite; }
  .color-ball.effect-12 { animation: plasmaTornado 3.5s linear infinite; }
  .color-ball.effect-13 { animation: crystalPulse 2s ease-in-out infinite; }
  .color-ball.effect-14 { animation: nebulaWave 3.8s ease-in-out infinite; }
  .color-ball.effect-15 { animation: prismShift 2.6s ease-in-out infinite; }
  .color-ball.effect-16 { animation: auroraFlow 4.2s ease-in-out infinite; }
  .color-ball.effect-17 { animation: quantumTeleport 3.4s ease-in-out infinite; }
  .color-ball.effect-18 { animation: cosmicBreathing 5s ease-in-out infinite; }

  /* 聚合与分散特效 */
  .color-ball.converging { animation: convergeEffect 2s ease-in-out forwards; }
  .color-ball.dispersing { animation: disperseEffect 2s ease-in-out forwards; }
  .color-ball.group-effect { animation: groupHarmony 3s ease-in-out infinite; }

  /* 18种全新炫酷特效关键帧 */
  @keyframes magneticBounce {
    0%, 100% { transform: translateY(0) scale(1); box-shadow: 0 0 20px rgba(255, 100, 150, 0.6); }
    25% { transform: translateY(-40px) scale(1.3); box-shadow: 0 0 40px rgba(255, 100, 150, 0.8); }
    50% { transform: translateY(-60px) scale(1.5); box-shadow: 0 0 60px rgba(255, 100, 150, 1); }
    75% { transform: translateY(-25px) scale(1.2); box-shadow: 0 0 30px rgba(255, 100, 150, 0.7); }
  }

  @keyframes cosmicSpin {
