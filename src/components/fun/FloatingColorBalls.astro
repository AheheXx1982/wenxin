    0% { transform: translateX(var(--original-x, 0)) translateY(var(--original-y, 0)) scale(1); }
    50% { transform: translateX(calc(var(--center-x, 0) - var(--original-x, 0))) translateY(calc(var(--center-y, 0) - var(--original-y, 0))) scale(0.8); }
    100% { transform: translateX(calc(var(--center-x, 0) - var(--original-x, 0))) translateY(calc(var(--center-y, 0) - var(--original-y, 0))) scale(1.2); }
  }

