  // 客户端响应式定位函数
  function generateResponsivePositions(count) {
    const positions = [];
    const containerWidth = 100; // 百分比
    const containerHeight = 100; // 百分比
    
    // 响应式球尺寸和间距调整
    const screenWidth = window.innerWidth;
    let ballSize, minDistance, fontArea;
    
    if (screenWidth <= 360) {
      // 最小屏幕
      ballSize = 4; // 更小的占用空间
      minDistance = 0.8;
      fontArea = { left: 10, right: 90, top: 20, bottom: 80 }; // 更宽松的字体区域
    } else if (screenWidth <= 480) {
      // 小屏幕
      ballSize = 5;
      minDistance = 1.0;
      fontArea = { left: 12, right: 88, top: 22, bottom: 78 };
    } else if (screenWidth <= 768) {
      // 平板
      ballSize = 5.5;
      minDistance = 1.1;
      fontArea = { left: 13, right: 87, top: 23, bottom: 77 };
    } else {
      // 桌面端
      ballSize = 6;
      minDistance = 1.2;
      fontArea = { left: 15, right: 85, top: 25, bottom: 75 };
    }
    
    let fontAreaCount = 0; // 字体区域球计数器
    
    for (let i = 0; i < count; i++) {
      let position;
      let attempts = 0;
      
      do {
        // 增大活动范围，允许负值和超出100%的值
        position = {
          left: (Math.random() - 0.1) * (containerWidth + 20) - 10, // 可以从-10%到110%
          top: (Math.random() - 0.05) * (containerHeight + 30) - 15  // 可以从-15%到115%
        };
        attempts++;
      } while (
        attempts < 100 && // 增加尝试次数
        (isInFontArea(position, fontArea, ballSize) && fontAreaCount >= 3) ||
        isTooClose(position, positions, ballSize * minDistance) // 使用响应式最小间距
      );
      
      // 如果球在字体区域，增加计数
      if (isInFontArea(position, fontArea, ballSize)) {
        fontAreaCount++;
      }
      
      positions.push(position);
    }
    
    return positions;
  }

  function isInFontArea(pos, fontArea, ballSize) {
    return pos.left + ballSize > fontArea.left &&
           pos.left < fontArea.right &&
           pos.top + ballSize > fontArea.top &&
           pos.top < fontArea.bottom;
  }

  function isTooClose(pos, existingPositions, minDistance) {
    return existingPositions.some(existing => {
      const distance = Math.sqrt(
        Math.pow(pos.left - existing.left, 2) +
        Math.pow(pos.top - existing.top, 2)
      );
      return distance < minDistance;
    });
  }

  // 颜色相近检测函数 - 使用HSL色彩空间计算相似度
  function hexToHsl(hex) {
    const r = parseInt(hex.slice(1, 3), 16) / 255;
    const g = parseInt(hex.slice(3, 5), 16) / 255;
    const b = parseInt(hex.slice(5, 7), 16) / 255;

    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    let h, s, l = (max + min) / 2;

    if (max === min) {
      h = s = 0;
    } else {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      switch (max) {
        case r: h = (g - b) / d + (g < b ? 6 : 0); break;
        case g: h = (b - r) / d + 2; break;
        case b: h = (r - g) / d + 4; break;
      }
      h /= 6;
    }

    return [h * 360, s * 100, l * 100];
  }

  // 判断两个颜色是否相近
  function areColorsSimilar(color1, color2, threshold = 30) {
    const [h1, s1, l1] = hexToHsl(color1);
    const [h2, s2, l2] = hexToHsl(color2);
    
    // 计算色相差异（考虑360度环形）
    let hueDiff = Math.abs(h1 - h2);
    if (hueDiff > 180) hueDiff = 360 - hueDiff;
    
    // 计算饱和度和亮度差异
    const satDiff = Math.abs(s1 - s2);
    const lightDiff = Math.abs(l1 - l2);
    
    // 综合判断相似度
    return hueDiff < threshold && satDiff < 20 && lightDiff < 25;
  }

  // 智能选择多样化颜色
  function selectDiverseColors(colors, count) {
    if (colors.length <= count) return colors;
    
    const selected = [];
    const remaining = [...colors];
    
    // 随机选择第一个颜色
    const firstIndex = Math.floor(Math.random() * remaining.length);
    selected.push(remaining.splice(firstIndex, 1)[0]);
    
    // 依次选择与已选颜色差异最大的颜色
    while (selected.length < count && remaining.length > 0) {
      let bestColor = null;
      let bestIndex = -1;
      let maxMinDistance = -1;
      
      for (let i = 0; i < remaining.length; i++) {
        const candidate = remaining[i];
        let minDistance = Infinity;
        
        // 计算与所有已选颜色的最小距离
        for (const selectedColor of selected) {
          if (areColorsSimilar(candidate.color, selectedColor.color, 50)) {
            minDistance = 0;
            break;
          }
          const [h1, s1, l1] = hexToHsl(candidate.color);
          const [h2, s2, l2] = hexToHsl(selectedColor.color);
          let hueDiff = Math.abs(h1 - h2);
          if (hueDiff > 180) hueDiff = 360 - hueDiff;
          const distance = hueDiff + Math.abs(s1 - s2) * 0.5 + Math.abs(l1 - l2) * 0.3;
          minDistance = Math.min(minDistance, distance);
        }
        
        // 选择最小距离最大的颜色（即与已选颜色差异最大的）
        if (minDistance > maxMinDistance) {
          maxMinDistance = minDistance;
          bestColor = candidate;
          bestIndex = i;
        }
      }
      
      if (bestColor) {
        selected.push(bestColor);
        remaining.splice(bestIndex, 1);
      } else {
        // 如果没有找到合适的颜色，随机选择一个
        const randomIndex = Math.floor(Math.random() * remaining.length);
        selected.push(remaining.splice(randomIndex, 1)[0]);
      }
    }
    
    return selected;
  }

  // 智能选择12个多样化的颜色
  const visibleColors = selectDiverseColors(themeColors, 12);

  // 18种炫酷特效系统
  class AdvancedEffectSystem {
    constructor() {
      this.effects = [
        'magneticBounce', 'cosmicSpin', 'quantumJump', 'etherealFloat',
        'stellarExplode', 'dimensionFusion', 'atomicFission', 'phantomBlink',
        'galaxyVortex', 'energyPopcorn', 'liquidSnake', 'plasmaTornado',
        'crystalPulse', 'nebulaWave', 'prismShift', 'auroraFlow',
        'quantumTeleport', 'cosmicBreathing'
      ];
      this.specialEffects = ['converging', 'dispersing', 'groupHarmony'];
      this.activeEffects = new Map(); // 跟踪每个球的当前特效
      this.effectGroups = new Map(); // 跟踪特效组合
    }

    // 随机选择特效模式：单个、小组、全体
    getRandomEffectMode() {
      const modes = [
        { type: 'single', weight: 25 },    // 25% 单个球特效
        { type: 'group', weight: 45 },     // 45% 小组特效 (2-4个球)
        { type: 'multiple', weight: 20 },  // 20% 多个球不同特效
        { type: 'converge', weight: 6 },   // 6% 聚合特效
        { type: 'disperse', weight: 4 }    // 4% 分散特效
      ];
      
      const totalWeight = modes.reduce((sum, mode) => sum + mode.weight, 0);
      let random = Math.random() * totalWeight;
      
      for (const mode of modes) {
        random -= mode.weight;
        if (random <= 0) return mode.type;
      }
      return 'single';
    }

    // 随机选择特效
    getRandomEffect() {
      return this.effects[Math.floor(Math.random() * this.effects.length)];
    }

    // 应用单个球特效
    applySingleEffect(balls) {
      const ball = balls[Math.floor(Math.random() * balls.length)];
      const effect = this.getRandomEffect();
      this.applyEffectToBall(ball, effect);
    }

    // 应用小组特效
    applyGroupEffect(balls) {
      const groupSize = Math.floor(Math.random() * 3) + 2; // 2-4个球
      const selectedBalls = this.getRandomBalls(balls, groupSize);
      const effect = this.getRandomEffect();
      
      selectedBalls.forEach(ball => {
        this.applyEffectToBall(ball, effect);
      });
    }

    // 应用多个不同特效
    applyMultipleEffects(balls) {
      const effectCount = Math.floor(Math.random() * 4) + 2; // 2-5个特效
      const selectedBalls = this.getRandomBalls(balls, effectCount);
      
      selectedBalls.forEach(ball => {
        const effect = this.getRandomEffect();
        this.applyEffectToBall(ball, effect);
      });
    }

    // 应用聚合特效
    applyConvergeEffect(balls) {
      const participantCount = Math.floor(Math.random() * 6) + 4; // 4-9个球
      const selectedBalls = this.getRandomBalls(balls, participantCount);
      
      // 计算聚合中心点
      const centerX = 50; // 容器中心
      const centerY = 50;
      
      selectedBalls.forEach(ball => {
        const rect = ball.getBoundingClientRect();
        const container = ball.parentElement.getBoundingClientRect();
        const currentX = ((rect.left - container.left) / container.width) * 100;
        const currentY = ((rect.top - container.top) / container.height) * 100;
        
        // 设置CSS变量用于动画
        ball.style.setProperty('--original-x', `${currentX}%`);
        ball.style.setProperty('--original-y', `${currentY}%`);
        ball.style.setProperty('--center-x', `${centerX}%`);
        ball.style.setProperty('--center-y', `${centerY}%`);
        
        this.applyEffectToBall(ball, 'converging');
      });
    }

    // 应用分散特效
    applyDisperseEffect(balls) {
      const participantCount = Math.floor(Math.random() * 8) + 3; // 3-10个球
      const selectedBalls = this.getRandomBalls(balls, participantCount);
      
      selectedBalls.forEach(ball => {
        // 生成随机分散方向
        const angle = Math.random() * Math.PI * 2;
        const distance = Math.random() * 100 + 50; // 50-150px
        const disperseX = Math.cos(angle) * distance;
        const disperseY = Math.sin(angle) * distance;
        
        ball.style.setProperty('--disperse-x', `${disperseX}px`);
        ball.style.setProperty('--disperse-y', `${disperseY}px`);
        
        this.applyEffectToBall(ball, 'dispersing');
      });
    }

    // 随机选择指定数量的球
    getRandomBalls(balls, count) {
      const shuffled = [...balls].sort(() => Math.random() - 0.5);
      return shuffled.slice(0, Math.min(count, balls.length));
    }

    // 为球应用特效
    applyEffectToBall(ball, effectName) {
      // 清除之前的特效
      this.clearBallEffects(ball);
      
      // 应用新特效
      if (this.effects.includes(effectName)) {
        const effectIndex = this.effects.indexOf(effectName) + 1;
        ball.classList.add(`effect-${effectIndex}`);
      } else if (this.specialEffects.includes(effectName)) {
        ball.classList.add(effectName);
      }
      
      // 记录当前特效
      this.activeEffects.set(ball, effectName);
      
      // 设置特效持续时间
      const duration = this.getEffectDuration(effectName);
      setTimeout(() => {
        this.clearBallEffects(ball);
      }, duration);
    }

    // 清除球的所有特效
    clearBallEffects(ball) {
      // 清除数字特效类
      for (let i = 1; i <= 18; i++) {
        ball.classList.remove(`effect-${i}`);
      }
      // 清除特殊特效类
      this.specialEffects.forEach(effect => {
        ball.classList.remove(effect);
      });
      this.activeEffects.delete(ball);
    }

    // 获取特效持续时间
    getEffectDuration(effectName) {
      const durations = {
        'magneticBounce': 3000, 'cosmicSpin': 2500, 'quantumJump': 2800,
        'etherealFloat': 4000, 'stellarExplode': 3000, 'dimensionFusion': 2800,
        'atomicFission': 3200, 'phantomBlink': 1500, 'galaxyVortex': 4000,
        'energyPopcorn': 2200, 'liquidSnake': 5000, 'plasmaTornado': 3500,
        'crystalPulse': 2000, 'nebulaWave': 3800, 'prismShift': 2600,
        'auroraFlow': 4200, 'quantumTeleport': 3400, 'cosmicBreathing': 5000,
        'converging': 2000, 'dispersing': 2000, 'groupHarmony': 3000
      };
      return durations[effectName] || 3000;
    }

    // 启动随机特效系统
    startRandomEffects(balls) {
      const triggerEffect = () => {
        const mode = this.getRandomEffectMode();
        
        switch (mode) {
          case 'single':
            this.applySingleEffect(balls);
            break;
          case 'group':
            this.applyGroupEffect(balls);
            break;
          case 'multiple':
            this.applyMultipleEffects(balls);
            break;
          case 'converge':
            this.applyConvergeEffect(balls);
            break;
          case 'disperse':
            this.applyDisperseEffect(balls);
            break;
        }
        
        // 随机间隔触发下一个特效 (2-8秒)
        const nextInterval = Math.random() * 6000 + 2000;
        setTimeout(triggerEffect, nextInterval);
      };
      
      // 初始延迟1秒后开始
      setTimeout(triggerEffect, 1000);
    }
  }

  // 粒子爆炸效果
  function createParticleExplosion(ball) {
    const rect = ball.getBoundingClientRect();
    const centerX = rect.left + rect.width / 2;
    const centerY = rect.top + rect.height / 2;
    
    for (let i = 0; i < 12; i++) {
      const particle = document.createElement('div');
      particle.className = 'particle';
      
      const angle = (i / 12) * Math.PI * 2;
      const distance = 50 + Math.random() * 30;
      const dx = Math.cos(angle) * distance;
      const dy = Math.sin(angle) * distance;
      
      particle.style.cssText = `
        left: ${centerX}px;
        top: ${centerY}px;
        --dx: ${dx}px;
        --dy: ${dy}px;
        background: ${getComputedStyle(ball).background};
      `;
      
      document.body.appendChild(particle);
      
      setTimeout(() => {
        particle.remove();
      }, 1000);
    }
  }

  // 悦耳音效系统
  class BeautifulAudioSystem {
    constructor() {
      this.audioContext = null;
      this.enabled = localStorage.getItem('audio-enabled') !== 'false';
      this.initAudioContext();
    }
    
    // 初始化音频上下文
    initAudioContext() {
      try {
        this.audioContext = new (window.AudioContext || window.webkitAudioContext)();
      } catch (e) {
        console.warn('Web Audio API not supported');
      }
    }
    
    // 创建悦耳的点击音效
    playClickSound(frequency = 800) {
      if (!this.enabled || !this.audioContext) return;
      
      const oscillator = this.audioContext.createOscillator();
      const gainNode = this.audioContext.createGain();
      
      // 连接音频节点
      oscillator.connect(gainNode);
      gainNode.connect(this.audioContext.destination);
      
      // 设置音效参数 - 清脆悦耳的音调
      oscillator.type = 'sine';
      oscillator.frequency.setValueAtTime(frequency, this.audioContext.currentTime);
      oscillator.frequency.exponentialRampToValueAtTime(frequency * 1.5, this.audioContext.currentTime + 0.1);
      oscillator.frequency.exponentialRampToValueAtTime(frequency * 0.8, this.audioContext.currentTime + 0.2);
      
      // 音量包络 - 快速攻击，平滑衰减
      gainNode.gain.setValueAtTime(0, this.audioContext.currentTime);
      gainNode.gain.linearRampToValueAtTime(0.3, this.audioContext.currentTime + 0.01);
      gainNode.gain.exponentialRampToValueAtTime(0.001, this.audioContext.currentTime + 0.3);
      
      // 播放音效
      oscillator.start(this.audioContext.currentTime);
      oscillator.stop(this.audioContext.currentTime + 0.3);
    }
    
    // 创建选中音效 - 更加优美的和弦
    playSelectSound(baseFreq = 523.25) { // C5音符
      if (!this.enabled || !this.audioContext) return;
      
      // 创建和弦音效 (大三和弦)
      const frequencies = [
        baseFreq,           // 根音
        baseFreq * 1.25,    // 大三度
        baseFreq * 1.5,     // 完全五度
        baseFreq * 2        // 八度
      ];
      
      frequencies.forEach((freq, index) => {
        const oscillator = this.audioContext.createOscillator();
        const gainNode = this.audioContext.createGain();
        
        oscillator.connect(gainNode);
        gainNode.connect(this.audioContext.destination);
        
        // 不同音符使用不同波形
        oscillator.type = index === 0 ? 'sine' : index === 1 ? 'triangle' : 'sine';
        oscillator.frequency.setValueAtTime(freq, this.audioContext.currentTime);
        
        // 音量设置 - 根音最响，其他音符较轻
        const volume = index === 0 ? 0.2 : 0.1;
        gainNode.gain.setValueAtTime(0, this.audioContext.currentTime);
        gainNode.gain.linearRampToValueAtTime(volume, this.audioContext.currentTime + 0.05);
        gainNode.gain.exponentialRampToValueAtTime(0.001, this.audioContext.currentTime + 0.8);
        
        oscillator.start(this.audioContext.currentTime);
        oscillator.stop(this.audioContext.currentTime + 0.8);
      });
    }
    
    // 创建颜色球轮换音效 - 轻柔的提示音
    playRotationSound() {
      if (!this.enabled || !this.audioContext) return;
      
      const oscillator = this.audioContext.createOscillator();
      const gainNode = this.audioContext.createGain();
      
      oscillator.connect(gainNode);
      gainNode.connect(this.audioContext.destination);
      
      // 轻柔的铃声效果
      oscillator.type = 'triangle';
      oscillator.frequency.setValueAtTime(1047, this.audioContext.currentTime); // C6
      oscillator.frequency.exponentialRampToValueAtTime(1319, this.audioContext.currentTime + 0.1); // E6
      oscillator.frequency.exponentialRampToValueAtTime(1047, this.audioContext.currentTime + 0.2); // C6
      
      // 非常轻柔的音量
      gainNode.gain.setValueAtTime(0, this.audioContext.currentTime);
      gainNode.gain.linearRampToValueAtTime(0.05, this.audioContext.currentTime + 0.02);
      gainNode.gain.exponentialRampToValueAtTime(0.001, this.audioContext.currentTime + 0.4);
      
      oscillator.start(this.audioContext.currentTime);
      oscillator.stop(this.audioContext.currentTime + 0.4);
    }
    
    // 根据颜色生成对应的音频频率
    getFrequencyFromColor(color) {
      // 将颜色转换为音符频率
      const colorMap = {
        '#ed6ea0': 523.25, // C5 - 粉色
        '#3b82f6': 587.33, // D5 - 蓝色
        '#10b981': 659.25, // E5 - 绿色
        '#f59e0b': 698.46, // F5 - 橙色
        '#ef4444': 783.99, // G5 - 红色
        '#8b5cf6': 880.00, // A5 - 紫色
        '#06b6d4': 987.77, // B5 - 青色
        '#84cc16': 1046.50, // C6 - 黄绿色
      };
      
      // 如果颜色不在映射中，根据颜色值计算频率
      if (colorMap[color]) {
        return colorMap[color];
      }
      
      // 根据颜色的RGB值计算频率
      const hex = color.replace('#', '');
      const r = parseInt(hex.substr(0, 2), 16);
      const g = parseInt(hex.substr(2, 2), 16);
      const b = parseInt(hex.substr(4, 2), 16);
      
      // 将RGB值映射到音符频率范围 (261.63Hz - 1046.50Hz)
      const brightness = (r + g + b) / 3;
      return 261.63 + (brightness / 255) * (1046.50 - 261.63);
    }
    
    // 设置音效开关
    setEnabled(enabled) {
      this.enabled = enabled;
      localStorage.setItem('audio-enabled', enabled.toString());
    }
  }

  // 随机交替显示系统
  class ColorBallRotationSystem {
    constructor(audioSystem) {
      this.allColors = themeColors;
      this.currentVisibleColors = visibleColors;
      this.rotationInterval = null;
      this.rotationEnabled = true;
      this.audioSystem = audioSystem;
    }
    
    // 获取未显示的颜色
    getHiddenColors() {
      return this.allColors.filter(color => 
        !this.currentVisibleColors.some(visible => visible.color === color.color)
      );
    }
    
    // 智能替换颜色球
    rotateColorBall() {
      if (!this.rotationEnabled) return;
      
      const hiddenColors = this.getHiddenColors();
      if (hiddenColors.length === 0) return;
      
      const balls = document.querySelectorAll('.color-ball');
      if (balls.length === 0) return;
      
      // 随机选择一个要替换的球（避免替换当前选中的球）
      const selectedBall = document.querySelector('.color-ball.selected');
      const availableBalls = Array.from(balls).filter(ball => ball !== selectedBall);
      
      if (availableBalls.length === 0) return;
      
      const ballToReplace = availableBalls[Math.floor(Math.random() * availableBalls.length)];
      const oldColorIndex = this.currentVisibleColors.findIndex(color => 
        color.color === ballToReplace.getAttribute('data-color')
      );
      
      // 选择新颜色，确保不与当前显示的颜色太相似
      let newColor;
      let attempts = 0;
      do {
        newColor = hiddenColors[Math.floor(Math.random() * hiddenColors.length)];
        attempts++;
      } while (attempts < 10 && this.isTooSimilarToVisible(newColor));
      
      // 更新颜色球
      this.updateBallColor(ballToReplace, newColor);
      
      // 更新内部状态
      if (oldColorIndex !== -1) {
        this.currentVisibleColors[oldColorIndex] = newColor;
      }
    }
    
    // 检查新颜色是否与当前显示的颜色太相似
    isTooSimilarToVisible(newColor) {
      return this.currentVisibleColors.some(visibleColor => {
        if (visibleColor.color === newColor.color) return false;
        return this.areColorsSimilar(newColor.color, visibleColor.color, 25);
      });
    }
    
    // 颜色相似度检测（复用之前的函数）
    areColorsSimilar(color1, color2, threshold = 30) {
      const hexToHsl = (hex) => {
        const r = parseInt(hex.slice(1, 3), 16) / 255;
        const g = parseInt(hex.slice(3, 5), 16) / 255;
        const b = parseInt(hex.slice(5, 7), 16) / 255;
        const max = Math.max(r, g, b);
        const min = Math.min(r, g, b);
        let h, s, l = (max + min) / 2;
        if (max === min) {
          h = s = 0;
        } else {
          const d = max - min;
          s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
          switch (max) {
            case r: h = (g - b) / d + (g < b ? 6 : 0); break;
            case g: h = (b - r) / d + 2; break;
            case b: h = (r - g) / d + 4; break;
          }
          h /= 6;
        }
        return [h * 360, s * 100, l * 100];
      };
      
      const [h1, s1, l1] = hexToHsl(color1);
      const [h2, s2, l2] = hexToHsl(color2);
      let hueDiff = Math.abs(h1 - h2);
      if (hueDiff > 180) hueDiff = 360 - hueDiff;
      const satDiff = Math.abs(s1 - s2);
      const lightDiff = Math.abs(l1 - l2);
      const similarity = hueDiff + satDiff * 0.5 + lightDiff * 0.3;
      return similarity < threshold;
    }
    
    // 更新球的颜色
    updateBallColor(ball, newColor) {
      // 使用纯色背景，避免渐变产生黑色
      
      ball.setAttribute('data-color', newColor.color);
      ball.setAttribute('title', newColor.name);
      ball.style.background = newColor.color;
      
      // 播放轮换音效
      if (this.audioSystem) {
        this.audioSystem.playRotationSound();
      }
      
      // 添加平滑过渡效果
      ball.style.transform = 'scale(0.8)';
      ball.style.opacity = '0.7';
      
      setTimeout(() => {
        ball.style.transform = '';
        ball.style.opacity = '';
      }, 300);
    }
    
    // 颜色加深函数（复用之前的逻辑）
    darkenColor(color, factor = 0.3) {
      const hex = color.replace('#', '');
      const r = parseInt(hex.substr(0, 2), 16);
      const g = parseInt(hex.substr(2, 2), 16);
      const b = parseInt(hex.substr(4, 2), 16);
      
      const brightness = (r * 299 + g * 587 + b * 114) / 1000;
      const adjustedFactor = brightness < 100 ? 0.3 : brightness < 150 ? 0.6 : factor;
      
      const newR = Math.max(30, Math.floor(r * (1 - adjustedFactor)));
      const newG = Math.max(30, Math.floor(g * (1 - adjustedFactor)));
      const newB = Math.max(30, Math.floor(b * (1 - adjustedFactor)));
      
      return `#${newR.toString(16).padStart(2, '0')}${newG.toString(16).padStart(2, '0')}${newB.toString(16).padStart(2, '0')}`;
    }
    
    // 启动随机交替显示
    startRotation() {
      this.rotationEnabled = true;
      this.rotationInterval = setInterval(() => {
        this.rotateColorBall();
      }, 8000 + Math.random() * 4000); // 8-12秒随机间隔
    }
    
    // 停止随机交替显示
    stopRotation() {
      this.rotationEnabled = false;
      if (this.rotationInterval) {
        clearInterval(this.rotationInterval);
        this.rotationInterval = null;
      }
    }
  }

  // 主初始化函数
  function initColorBalls() {
    const balls = document.querySelectorAll('.color-ball');
    const currentTheme = localStorage.getItem('theme-color') || 'pink';
    
    // 控制状态
    let animationEnabled = localStorage.getItem('animation-enabled') !== 'false';
    
    // 初始化音效系统
    const audioSystem = new BeautifulAudioSystem();
    
    // 初始化颜色球轮换系统
    const rotationSystem = new ColorBallRotationSystem(audioSystem);
    
    // 设置初始选中状态
    balls.forEach(ball => {
      const themeValue = ball.getAttribute('data-value');
      if (themeValue === currentTheme) {
        ball.classList.add('selected');
      }
      

      
      // 点击事件
      ball.addEventListener('click', function() {
        // 播放点击音效
        const colorValue = ball.getAttribute('data-color');
        const frequency = audioSystem.getFrequencyFromColor(colorValue);
        audioSystem.playClickSound(frequency);
        
        // 添加点击特效
        ball.classList.add('clicked');
        setTimeout(() => ball.classList.remove('clicked'), 600);
        
        // 创建粒子爆炸
        createParticleExplosion(ball);
        // 移除所有选中状态
        balls.forEach(b => b.classList.remove('selected'));
        // 添加当前选中状态
        ball.classList.add('selected');
        
        // 播放选中音效
        setTimeout(() => {
          audioSystem.playSelectSound(frequency);
        }, 150);
        
        // 更新主题颜色
        const themeValue = ball.getAttribute('data-value');
        document.documentElement.setAttribute('data-theme-color', themeValue);
        localStorage.setItem('theme-color', themeValue);
        
        // 触发主题颜色变更事件
        document.dispatchEvent(new CustomEvent('theme-color-changed', {
          detail: { 
            color: themeValue,
            colorHex: colorValue,
            colorName: ball.getAttribute('title'),
            colorData: themeColors.find(c => c.value === themeValue)
          }
        }));
        
        console.log(`🎨 切换到主题颜色: ${ball.getAttribute('title')} (${colorValue})`);
      });
    });
    
    // 动画控制函数
    function toggleAnimations(enabled) {
      balls.forEach(ball => {
        if (enabled) {
          ball.style.animationPlayState = 'running';
        } else {
          ball.style.animationPlayState = 'paused';
        }
      });
    }
    
    // 初始化动画状态
    toggleAnimations(animationEnabled);
    
    // 监听动画状态变化
    window.addEventListener('animationStateChanged', function(e) {
      animationEnabled = e.detail.enabled;
      toggleAnimations(animationEnabled);
      console.log('动画状态更新:', animationEnabled ? '开启' : '关闭');
    });
    
    // 监听音效状态变化
    window.addEventListener('audioStateChanged', function(e) {
      audioSystem.setEnabled(e.detail.enabled);
      console.log('音效状态更新:', e.detail.enabled ? '开启' : '关闭');
    });
    
    // 启动颜色球轮换系统
    rotationSystem.startRotation();
    
    // 启动18种炫酷特效系统
    const effectSystem = new AdvancedEffectSystem();
    effectSystem.startRandomEffects(balls);
    
    console.log(`🎉 初始化了 ${balls.length} 个超炫酷颜色球！`);
    console.log(`🎨 纯色显示系统已启动！避免渐变和黑色问题！`);
    console.log(`✨ 18种随机特效系统已启动！支持单个/多个/聚合/分散特效！`);
    console.log(`🔄 随机交替显示系统已启动！`);
  }

  // 页面加载时初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initColorBalls);
  } else {
    initColorBalls();
  }

  // Astro页面切换时重新初始化
  document.addEventListener('astro:page-load', initColorBalls);
  
  // 窗口大小变化时重新布局（防抖处理）
  let resizeTimeout;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
      // 重新生成位置并更新球的位置
      const container = document.querySelector('.color-balls-container');
      if (container) {
        const balls = container.querySelectorAll('.color-ball');
        const newPositions = generateResponsivePositions(balls.length);
        
        balls.forEach((ball, index) => {
          if (newPositions[index]) {
            ball.style.left = `${newPositions[index].left}%`;
            ball.style.top = `${newPositions[index].top}%`;
          }
        });
        
        console.log('📱 响应式布局已更新，适配当前屏幕尺寸');
      }
    }, 300); // 300ms防抖
  });
</script>