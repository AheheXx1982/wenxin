---
import EmptySvg from '@components/svg/EmptySvg';
import Divider from '@components/ui/divider';
import { defaultCoverList } from '@constants/site-config';
import { getRandomCoverForPath } from '@lib/cover';
import type { Page } from 'astro';
import { shuffle } from 'es-toolkit';
import type { BlogPost } from 'types/blog';
import CategoryCards from './CategoryCards.astro';
import Paginator from './Paginator.astro';
import PostItemCard from './PostItemCard.astro';

interface Props {
  posts?: BlogPost[];
  page?: Page<BlogPost>;
  showPaginator?: boolean;
}

const { posts, page, showPaginator = true } = Astro.props;
// 为每篇文章生成对应分类的随机封面图片
const covers =
  posts?.map((post) => {
    // 获取文章的分类路径
    const categories = post.data.categories;
    if (categories && Array.isArray(categories) && categories.length > 0) {
      // 处理嵌套分类格式
      if (Array.isArray(categories[0])) {
        // 例如: ['新世界探索', '智能进化']
        const categoryPath = categories[0].join('/');
        return getRandomCoverForPath(`/categories/${categoryPath}`);
      } else {
        // 处理单级分类格式
        // 例如: '期权研究院'
        return getRandomCoverForPath(`/categories/${categories[0]}`);
      }
    }
    // 如果没有分类信息，使用默认的随机图片
    const shuffled = shuffle(defaultCoverList);
    return shuffled[0];
  }) || [];
---

<Divider>文章列表</Divider>
{
  !posts?.length && (
    <div class="text-foreground/30 flex flex-col items-center gap-2">
      <EmptySvg className="fill-foreground/20" />
      <span>还没有发表文章哦～</span>
    </div>
  )
}
{
  posts && posts?.length > 0 && (
    <>
      <div class="flex flex-col">
        {posts.map((post, index) => (
          <div class="p-4">
            <PostItemCard data={post} leftClip={index % 2 === 0} randomCover={covers[index]} />
          </div>
        ))}
      </div>
      {showPaginator && page && <Paginator page={page} />}
    </>
  )
}
<Divider>精选分类</Divider>
<CategoryCards />
