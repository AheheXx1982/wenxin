---
import type { Category } from '@lib/content';
import CategoryTitle from './CategoryTitle.astro';
import { getCategoryLink } from '@lib/content';
import { categoryMap } from '@constants/category';
import { getUIText } from '@lib/i18n';

interface Props {
  category: Category;
  parentName: string;
  countMap: Record<string, number>;
  lang?: 'zh' | 'en';
}

const { category, parentName, countMap, lang = 'zh' } = Astro.props;
const uiText = getUIText(lang);

// 分类名称翻译函数
const translateCategoryName = (categoryName: string): string => {
  if (lang === 'en' && uiText.categoryNames) {
    const translated = (uiText.categoryNames as Record<string, string>)[categoryName];
    return translated || categoryName;
  }
  return categoryName;
};

// 翻译分类名称
const translatedCategoryName = translateCategoryName(category.name);
const categoryLinkPrefix = lang === 'en' ? '/en/categories' : '/categories';

// 修复:确保使用正确的分类映射
const parentLink = categoryMap[parentName] || parentName;
const childLink = categoryMap[category.name] || category.name;
const categoryLink = `${parentLink}/${childLink}`;

// 加密百科特殊处理:直接链接到外部网站
const isCryptoWiki = category.name === '加密百科';
const categoryHref = isCryptoWiki ? 'https://crypto.silentxx.com/' : `${categoryLinkPrefix}/${categoryLink}`;
const categoryTarget = isCryptoWiki ? '_blank' : '_self';
const grandChildLinks = await Promise.all(
  (category.children || []).map(async (grandChild) => {
    const parentLink = categoryMap[parentName] || parentName;
    const childLink = categoryMap[category.name] || category.name;
    const grandChildLink = categoryMap[grandChild.name] || grandChild.name;
    const fullLink = `${parentLink}/${childLink}/${grandChildLink}`;
    return {
      grandChild,
      link: fullLink,
      translatedName: translateCategoryName(grandChild.name),
    };
  }),
);
---

<CategoryTitle
  title={translatedCategoryName}
  count={countMap[category.name] ?? 0}
  href={categoryHref}
  target={categoryTarget}
  level="h3"
/>
{
  grandChildLinks.length > 0 && (
    <div class="category-second-level-container flex flex-col">
      {grandChildLinks.map(({ grandChild, link, translatedName }) => (
        <p class="shoka-decoration-circle text-primary hover:text-blue relative px-7.5 py-2 text-base/9">
          <a href={`${categoryLinkPrefix}/${link}`} class="dashed-border border-b">
            {translatedName}
          </a>
          <span class="text-muted-foreground text-sm">({countMap[grandChild.name] ?? 0})</span>
        </p>
      ))}
    </div>
  )
}
