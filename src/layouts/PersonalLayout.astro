---
// PersonalLayout — 问心·个人频道
import '@styles/index.css';
import Footer from '@components/layout/Footer.astro';
import { Icon } from 'astro-icon/components';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = '投资 · AI · 写作 · 生活', ogImage } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ClientRouter />
    <meta name="robots" content="index, follow" />
    <title>{title} | 问心剑</title>
    <meta name="description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:title" content={`${title} | 问心剑`} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={`https://wenxin.silentxx.com${Astro.url.pathname}`} />
  </head>
  <body class="min-h-screen bg-stone-50 text-gray-800">
    <!-- Header — 问心品牌 -->
    <header class="sticky top-0 z-50 border-b border-stone-200 bg-stone-50/90 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-6">
        <a href="/personal" class="group flex items-center gap-3 text-stone-700 transition-colors hover:text-stone-900">
          <div
            class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-100 transition-colors group-hover:bg-amber-200"
          >
            <Icon name="ri:quill-pen-line" class="h-4 w-4 text-amber-600" />
          </div>
          <span class="font-serif text-lg tracking-wide">问心</span>
          <span class="hidden text-xs text-stone-400 sm:inline">· 问心剑的个人笔记</span>
        </a>
        <nav class="flex items-center gap-4 text-sm text-stone-500">
          <a href="/personal" class="transition-colors hover:text-amber-600">首页</a>
          <a href="/personal/articles" class="transition-colors hover:text-amber-600">文章</a>
          <a href="/personal/about" class="transition-colors hover:text-amber-600">关于</a>
          <a href="https://silentxx.com" class="text-stone-300 transition-colors hover:text-stone-500" title="返回主站">
            <Icon name="ri:arrow-left-line" class="h-4 w-4" />
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="mx-auto max-w-3xl px-6 py-12">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-stone-200 py-8 text-center text-sm text-stone-400">
      <div class="mx-auto max-w-3xl space-y-1 px-6">
        <p>
          问心 <span class="text-stone-300">·</span>
          <a href="https://silentxx.com" class="transition-colors hover:text-stone-600">SilentXx</a> 个人频道
        </p>
        <p class="text-xs">投资 · AI · 写作 · 生活 — 先问心，再出剑。</p>
      </div>
    </footer>
  </body>
</html>
