---
import { getCategoryList, getCategoryLinks } from '@lib/content';

const { categories: zhCategories } = await getCategoryList('zh');
const { categories: enCategories } = await getCategoryList('en');

const zhLinks = getCategoryLinks(zhCategories, '');
const enLinks = getCategoryLinks(enCategories, '');
---

<html lang="zh">
  <head>
    <title>Debug Categories</title>
  </head>
  <body>
    <h1>中文分类</h1>
    <pre>{JSON.stringify(zhCategories, null, 2)}</pre>
    <h2>中文分类链接</h2>
    <pre>{JSON.stringify(zhLinks, null, 2)}</pre>

    <hr />

    <h1>英文分类</h1>
    <pre>{JSON.stringify(enCategories, null, 2)}</pre>
    <h2>英文分类链接</h2>
    <pre>{JSON.stringify(enLinks, null, 2)}</pre>
  </body>
</html>
