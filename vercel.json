{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ],
  "buildCommand": "pnpm build",
  "installCommand": "corepack enable && pnpm install --no-frozen-lockfile",
  "outputDirectory": "dist",
  "framework": "astro",
  "build": {
    "env": {
      "ENABLE_FILE_SYSTEM_API": "1",
      "NODE_OPTIONS": "--max-old-space-size=4096"
    }
  }
}
